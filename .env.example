# ---- Web ---------------------------------------------------------------
# The app speaks plain http on loopback; nginx in front provides https.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Public https URL of the site (must match the domain nginx serves)
PUBLIC_URL=https://track.example.com
# Proxies trusted for X-Forwarded-* headers. 'loopback' = the local nginx.
TRUST_PROXY=loopback

# ---- GPS TCP server ------------------------------------------------------
# Trackers connect to  <your-domain>:GPS_PORT  over plain TCP (not through nginx)
GPS_PORT=8090
# GT06 (also GK309/GK301/GK306 and clones). Others: TK103, TK510, GT02A, ST901, H02
GPS_PROTOCOL=GT06

# ---- Google --------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials
# OAuth client (type: Web). Add https://<your-domain> under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Browser API key with "Maps JavaScript API" enabled; restrict by HTTP referrer to your domain.
GOOGLE_MAPS_API_KEY=
# Optional: a Map ID (enables vector map + cloud styling). Default works for markers.
GOOGLE_MAP_ID=DEMO_MAP_ID

# ---- Access control --------------------------------------------------------
# Comma separated. Admins can see every device and release a serial claimed by mistake.
ADMIN_EMAILS=
# Optional allow-list. Leave empty to let any Google account register.
ALLOWED_EMAILS=

# ---- Misc ------------------------------------------------------------------
# Timezone used for "day" boundaries in history and for expiry notifications
APP_TIMEZONE=Asia/Dhaka
# Contact for web-push (VAPID) - mailto: or https URL
VAPID_SUBJECT=mailto:admin@arifdev.com
DB_PATH=./gps.db
# Delete GPS points older than N days (0 = keep forever)
RETENTION_DAYS=0
